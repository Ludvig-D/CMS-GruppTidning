# Local dev: OK to use the space's Preview token (draft content visible while editing).
# Production (Vercel): MUST be the Public token instead — see README's deploy checklist.
STORYBLOK_DELIVERY_API_TOKEN=
STORYBLOK_REGION=eu
SITE_URL=http://localhost:3000

# Only needed to run scripts/setup-storyblok.mjs, never used at runtime:
STORYBLOK_MGMT_TOKEN=
STORYBLOK_ORG_ID=
STORYBLOK_SPACE_ID=
